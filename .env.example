PORT=3000

# Preferred for Kimi via Moonshot OpenAI-compatible API
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=your-moonshot-api-key
COPILOTKIT_MODEL=kimi-k2.7-code

# Optional fallback key name supported by the app
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=

# Optional: observability DuckDB path override (default mastra.duckdb; use ":memory:" or a temp path for parallel instances)
MASTRA_DUCKDB_PATH=

# Optional: Vite dev server /api proxy target (default http://localhost:3000)
WC_API_TARGET=
